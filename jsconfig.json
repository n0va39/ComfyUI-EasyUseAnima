{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": false
  },
  "include": [
    "web/js/aio/**/*.js",
    "web/js/easyuse_anima_prompt_studio.js",
    "web/js/easyuse_anima_prompt_studio_regional.js",
    "web/js/prompt_studio/**/*.js"
  ]
}
